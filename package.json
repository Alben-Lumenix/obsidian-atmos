{
  "name": "atmos-obsidian",
  "version": "0.1.1",
  "private": true,
  "description": "Insert current weather into Obsidian notes",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration:live": "node scripts/real-api-test.mjs --live",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm run build && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0"
  }
}
